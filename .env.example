# Copy this file to .env and fill in real values. Never commit the real .env
# file — it's already excluded in .gitignore.

# Postgres connection string (e.g. from Neon, Supabase, or any Postgres host)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email sending (SMTP = the protocol; SMTP_USER/SMTP_PASS ARE your email + password)
# For Gmail:
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Create an "App Password": myaccount.google.com/apppasswords (regular Gmail password won't work here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16characterapppassword
MAIL_FROM="Zalgo Infotech <youraddress@gmail.com>"
CONTACT_TO_EMAIL=you@example.com
JOB_APPLICATION_TO_EMAIL=you@example.com
PLAN_INQUIRY_TO_EMAIL=you@example.com

# Admin dashboard login (/admin)
# Generate a password hash with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('yourNewPassword', 12)).toString('base64'))"
# (base64-encoded because the raw bcrypt hash contains `$` characters that
# Next.js's env loader misinterprets as variable-substitution syntax)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH_B64=
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string-in-production
